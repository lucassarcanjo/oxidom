{
  "name": "rsdom-monorepo",
  "private": true,
  "description": "rsdom: a fast, drop-in replacement for jsdom, implemented in Rust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucassarcanjo/jetdom.git"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "e2e/react-app"
  ],
  "scripts": {
    "build": "npm run build --workspace=jetdom",
    "build:debug": "npm run build:debug --workspace=jetdom",
    "test": "npm run test:rust && npm run test:js && npm run test:e2e",
    "test:rust": "cargo test --workspace",
    "test:js": "npm test --workspace=jetdom",
    "test:fallback": "npm run test:fallback --workspace=jetdom",
    "test:e2e": "npm run test:rsdom --workspace=e2e/react-app",
    "test:parity": "node conformance/parity/run.mjs",
    "check": "npm run lint && npm test && npm run test:fallback && npm run test:parity && npm run check:scoreboard",
    "check:scoreboard": "node conformance/parity/report.mjs > /dev/null && git diff --exit-code conformance/parity/results/summary.md",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all --check",
    "fmt": "cargo fmt --all",
    "bench:m0": "node --expose-gc bench/micro/m0-gates.mjs",
    "bench:micro": "node --expose-gc bench/micro/run.mjs",
    "bench:e2e": "node bench/e2e/run.mjs"
  },
  "devDependencies": {
    "js-yaml": "5.5.0",
    "parse5": "8.0.1"
  }
}
