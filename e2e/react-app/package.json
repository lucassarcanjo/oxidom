{
  "name": "e2e-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React 19 app + Testing Library suite (11 files, 90 tests): the end-to-end acceptance and benchmark subject, run under jsdom, happy-dom and oxidom.",
  "scripts": {
    "test": "vitest run",
    "test:jsdom": "DOM_ENV=jsdom vitest run",
    "test:happy-dom": "DOM_ENV=happy-dom vitest run",
    "test:oxidom": "DOM_ENV=oxidom vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.3",
    "oxidom": "0.1.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vitest-environment-oxidom": "0.1.0"
  }
}
